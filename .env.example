# Copy to .env and adjust. .env is gitignored.

# --- Postgres (consumed by docker-compose.yml and the backend) ---
POSTGRES_USER=gabai
POSTGRES_PASSWORD=gabai
POSTGRES_DB=gabai
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Backend ---
# Rotate before any public deployment. Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-only-change-me
ENVIRONMENT=development
# Not used in either environment as configured. The Vite dev server proxies /api
# to the backend, and in production Caddy serves both from one origin, so the
# browser never makes a cross-origin request. Kept for a frontend run without
# that proxy. Do not treat it as support for a separately hosted frontend: the
# session cookie is SameSite=Lax and would not be sent.
CORS_ORIGINS=http://localhost:5173

# --- Classifier ---
# Below this a request goes to manual review. Placeholder until the threshold sweep sets the real value.
CONFIDENCE_THRESHOLD=0.70

# --- First admin (read by `python -m app.seed`, once, after migrating) ---
# Registration only ever creates citizens and every admin route needs an existing
# admin, so a fresh database has no way in without this. No default password on
# purpose: the seed refuses to run rather than create a guessable account.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrator

# Demo accounts for evaluation week. Off by default, this repo is public.
SEED_DEMO=0
SEED_DEMO_PASSWORD=
