# Copy to .env and adjust. .env is gitignored.

# --- Postgres (consumed by docker-compose.yml and the backend) ---
POSTGRES_USER=gabai
POSTGRES_PASSWORD=gabai
POSTGRES_DB=gabai
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Backend ---
# Rotate before any public deployment. Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-only-change-me
ENVIRONMENT=development
# Not used in either environment as configured. The Vite dev server proxies /api
# to the backend, and in production Caddy serves both from one origin, so the
# browser never makes a cross-origin request. Kept for a frontend run without
# that proxy. Do not treat it as support for a separately hosted frontend: the
# session cookie is SameSite=Lax and would not be sent.
CORS_ORIGINS=http://localhost:5173

# --- Classifier ---
# Below this a request goes to manual review. Placeholder until the threshold sweep sets the real value.
CONFIDENCE_THRESHOLD=0.70

# --- Email (Resend) ---
# Empty key means no email goes out. In development the email is written to the
# log instead, so links still work locally.
RESEND_API_KEY=
MAIL_FROM=GABAI <no-reply@gabai.help>
# Where emailed links point. The site's address.
PUBLIC_URL=http://localhost:5173
# Staff can only approve residents with a confirmed email. Set to false only
# while email isn't set up yet.
REQUIRE_VERIFIED_EMAIL=true

# --- First admin (read by `python -m app.seed`, once, after migrating) ---
# Registration only ever creates citizens and every admin route needs an existing
# admin, so a fresh database has no way in without this. No default password on
# purpose: the seed refuses to run rather than create a guessable account.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrator

# Demo accounts for evaluation week. Off by default, this repo is public.
SEED_DEMO=0
SEED_DEMO_PASSWORD=

# --- Retention (read by `python -m app.retention`, see backend/app/retention.py) ---
# Empty means keep forever. The periods are the barangay's decision under RA 10173;
# set them once agreed. Days after a request is resolved or closed before its text,
# notes and attachments are removed:
RETENTION_REQUEST_DAYS=
# Days after a citizen account is deactivated or rejected before its name, email
# and residence are removed:
RETENTION_ACCOUNT_DAYS=
# Days before an audit entry's IP address is cleared:
RETENTION_IP_DAYS=

# --- Backups (read by scripts/backup.sh) ---
# Relative to the repo root, which is gitignored there.
BACKUP_DIR=backups
BACKUP_KEEP_DAYS=14
