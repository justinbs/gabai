# Copy to .env and adjust. .env is gitignored.

# --- Postgres (consumed by docker-compose.yml and the backend) ---
POSTGRES_USER=gabai
POSTGRES_PASSWORD=gabai
POSTGRES_DB=gabai
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Backend ---
# Rotate before any public deployment. Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
SECRET_KEY=dev-only-change-me
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173

# --- Classifier ---
# Predictions below this go to the manual review queue. Tuned empirically, not by feel.
CONFIDENCE_THRESHOLD=0.70
