# --- Secrets ---
.env
.env.*
!.env.example

# --- Python / backend ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage

# --- Node / frontend ---
node_modules/
dist/
dist-ssr/
.vite/
*.tsbuildinfo
*.local
npm-debug.log*
yarn-error.log*

# --- ML artifacts (large binaries; keep code and CSV, not weights) ---
ml/checkpoints/
ml/runs/
ml/artifacts/
*.onnx
*.safetensors
*.bin
*.pt

# --- Uploads (runtime user data; never in VCS) ---
backend/uploads/

# --- Editors / OS ---
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Trained and exported models. Hundreds of MB, rebuilt by ml/scripts, and this
# repo is public.
ml/models/
backend/models/

# Draft artifacts from the pipeline test. When the real dataset lands, delete
# requests.csv, train.csv, val.csv, test.csv and the json, then drop the two
# lines directly below. Not the rows- rule under them.
ml/data/*.csv
ml/results/*.json

# Three people on one CSV is a merge conflict every time, so each writes their
# own and they get merged at the end. Tracked from the first row.
!ml/data/rows-*.csv
